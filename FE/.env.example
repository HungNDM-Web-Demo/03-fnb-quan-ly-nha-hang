# Sao chép file này thành .env.local (không commit .env.local)

NEXT_PUBLIC_APP_NAME=Quản lý Nhà hàng

# mock: chạy bằng dữ liệu mẫu trong trình duyệt, không cần BE
# api : gọi BE thật tại NEXT_PUBLIC_API_URL
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=https://localhost:7103

# Thanh công cụ demo (đổi vai trò, đặt lại dữ liệu, đổi màu)
NEXT_PUBLIC_DEMO_TOOLBAR=true
# Mật khẩu tài khoản demo khi chạy chế độ mock (trùng DEMO_PASSWORD của BE)
NEXT_PUBLIC_DEMO_PASSWORD=Demo@123
