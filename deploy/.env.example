# Sao chép thành deploy/.env (không commit). Dùng cho docker-compose.yml trong thư mục này.
# Tên biến BE trùng BE/src/API/.env.example, tên biến FE trùng FE/.env.example.

# ===== Postgres (service postgres trong compose; BE nhận CONNECTION_STRING ghép từ 3 biến này) =====
# Tên DB có chữ hoa: trong psql phải đặt trong ngoặc kép, vd \c "WebDemo_FnbQuanLyNhaHang"
POSTGRES_DB=WebDemo_FnbQuanLyNhaHang
POSTGRES_USER=webdemo
POSTGRES_PASSWORD=doi-mat-khau-nay

# ===== BE =====
# true khi BE chạy sau reverse proxy (mặc định); compose chỉ bind 127.0.0.1 nên để true
BEHIND_PROXY=true

# JWT_KEY tối thiểu 32 ký tự. Sinh bằng PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_KEY=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_ISSUER=fnb-quan-ly-nha-hang
JWT_AUDIENCE=fnb-quan-ly-nha-hang
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Origin của FE mà trình duyệt mở (nhiều origin cách nhau bằng dấu phẩy). Chạy local: http://localhost:3103
CORS_ORIGINS=http://localhost:3103

# Demo: bật /api/demo/*, nạp dữ liệu mẫu khi DB trống, tự đặt lại theo cron (giờ Việt Nam; để trống thì tắt)
DEMO_MODE=true
DEMO_PASSWORD=Demo@123
DEMO_RESET_CRON=0 3 * * *

# ===== FE (NEXT_PUBLIC_* nhúng lúc build image; đổi thì `docker compose up -d --build` lại) =====
NEXT_PUBLIC_APP_NAME=Quản lý Nhà hàng
# api: gọi BE; mock: chỉ dữ liệu mẫu trong trình duyệt (khi đó không cần be, postgres)
NEXT_PUBLIC_DATA_SOURCE=api
# Địa chỉ BE mà TRÌNH DUYỆT gọi được. Chạy local: http://localhost:7103; có tên miền: https://api-fnb-quan-ly-nha-hang.demo.pum.vn
NEXT_PUBLIC_API_URL=http://localhost:7103
NEXT_PUBLIC_DEMO_TOOLBAR=true
# Mật khẩu tài khoản demo ở chế độ mock; bỏ trống thì lấy DEMO_PASSWORD
NEXT_PUBLIC_DEMO_PASSWORD=Demo@123
# Chỉ một số dự án dùng (trang công khai, sitemap); không dùng thì để trống
NEXT_PUBLIC_SITE_URL=
# Server Next gọi BE qua mạng nội bộ: compose đã đặt sẵn API_INTERNAL_URL=http://be:8080, không cần khai ở đây.
