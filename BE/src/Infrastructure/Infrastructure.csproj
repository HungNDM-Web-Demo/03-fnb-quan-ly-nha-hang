<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" />
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <!--
    Dữ liệu mẫu chỉ có một nguồn: FE/src/mock/seed/*.json (KIEN-TRUC-HE-THONG §6.2 quy tắc 8).
    Nhúng nguyên các file đó vào assembly với tên "Seed.{tên file}", vd Seed.system.json.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\FE\src\mock\seed\*.json"
                      LogicalName="Seed.%(Filename)%(Extension)"
                      Link="Persistence\Seeders\Data\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
  </ItemGroup>

</Project>
